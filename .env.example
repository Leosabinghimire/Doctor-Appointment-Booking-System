# Copy this file to `.env.local` and adjust values for your environment.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL for the REST backend (used when VITE_USE_MOCK=false)
VITE_API_URL=https://api.your-domain.com/v1

# Toggle the mock data layer in src/api/services/*.
# When `true`, services return data from src/data/mock.ts via fakeDelay().
# When `false`, services hit VITE_API_URL through the Axios client.
VITE_USE_MOCK=true
