# Copy to `server/.env` and fill in. Loaded automatically on startup.
# Never commit the real .env — it holds your Telentir API key.

PORT=4000
# Comma-separated browser origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# ---- Telentir (https://docs.telentir.com) ----
# Leave TELENTIR_API_KEY empty to run without Telentir (call sync/reminders are disabled).
# Create a key in the Telentir dashboard: Settings → API Keys.
TELENTIR_API_KEY=
# Override only for self-hosted Telentir. Default: https://app.telentir.com
TELENTIR_API_URL=
# ID of the AI agent that places reminder calls (Telentir dashboard → Agents).
TELENTIR_AGENT_ID=
# Optional: knowledge base the agent can use (created by `npm run telentir:knowledge`).
TELENTIR_KNOWLEDGE_BASE_ID=
# How often to pull call history from Telentir, in seconds. 0 disables polling.
TELENTIR_SYNC_INTERVAL_SEC=60
